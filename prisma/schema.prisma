generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Center {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  village   String
  district  String
  state     String
  active    Boolean  @default(true)
  children  Child[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  role              String    @default("WORKER")
  phone             String
  preferredLanguage String   @default("en")
  centerIds         Json
  active            Boolean   @default(true)
  passwordHash      String
  guardians         Guardian[]
  observations      Observation[]
  assessments       MilestoneAssessment[]
  developmentAssessments DevelopmentAssessment[]
  assignedFollowUps  FollowUp[]
  assignedChildren  Child[] @relation("AssignedWorker")
  recommendations   Recommendation[]
  sentMessages      Message[] @relation("MessageSender")
  receivedMessages  Message[] @relation("MessageRecipient")
  chatLogs          ChatLog[]
  auditLogs         AuditLog[]
  authSessions      AuthSession[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SignupRequest {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  role           String
  centerName     String?
  childReference String?
  relationship   String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@index([email])
}

model Guardian {
  id                String    @id @default(cuid())
  name              String
  phone             String
  preferredLanguage String   @default("en")
  address           String
  linkedUserId      String?
  linkedUser        User?     @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  childLinks        ChildGuardian[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ChildGuardian {
  childId      String
  guardianId   String
  relationship String
  isPrimary    Boolean   @default(false)
  child        Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian     Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  @@id([childId, guardianId])
  @@index([guardianId])
}

model Child {
  id                    String              @id @default(cuid())
  internalId            String              @unique
  fullName              String
  dateOfBirth           DateTime
  gender                String              @default("UNSPECIFIED")
  centerId              String
  assignedWorkerId      String
  enrollmentDate        DateTime            @default(now())
  profilePhotoPath      String?
  primaryLanguage       String              @default("en")
  consentStatus         String              @default("PENDING")
  emergencyContactName  String
  emergencyContactPhone String
  siblingIds            Json
  active                Boolean             @default(true)
  center                Center              @relation(fields: [centerId], references: [id], onDelete: Restrict)
  assignedWorker        User                @relation("AssignedWorker", fields: [assignedWorkerId], references: [id], onDelete: Restrict)
  guardianLinks         ChildGuardian[]
  observations          Observation[]
  assessments           MilestoneAssessment[]
  risks                 RiskAssessment[]
  recommendations       Recommendation[]
  messages              Message[]
  reports               ReportRecord[]
  growthMeasurements    GrowthMeasurement[]
  developmentAssessments DevelopmentAssessment[]
  followUps             FollowUp[]
  predictions           MLPrediction[]
  attachments           AttachmentRecord[]
  chatLogs              ChatLog[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([centerId, active])
}

model GrowthMeasurement {
  id                  String   @id @default(cuid())
  childId             String
  measuredAt          DateTime
  heightCm            Float
  weightKg            Float
  headCircumferenceCm Float?
  notes               String?
  measurementSource   String   @default("WORKER_ENTRY")
  measuredById        String?
  verificationStatus  String   @default("UNREVIEWED")
  child               Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([childId, measuredAt])
  @@index([verificationStatus, measuredAt])
}

model AttachmentRecord {
  id              String   @id @default(cuid())
  observationId   String?
  childId         String
  kind            String
  fileName        String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  uploadedById    String
  consentVerified Boolean  @default(false)
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([childId])
}

model Observation {
  id                 String              @id @default(cuid())
  childId            String
  createdById        String
  observedAt         DateTime
  method             String
  observationLanguage String            @default("en")
  domain             String
  activityContext    String
  observationText    String
  workerNotes        String
  originalText       String?
  idempotencyKey     String?
  aiTranscript       String?
  aiExtractedSummary String?
  followUpRequired   Boolean             @default(false)
  reviewStatus       String              @default("REVIEW_PENDING")
  attachmentIds      Json
  child              Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assessments        MilestoneAssessment[]
  developmentAssessments DevelopmentAssessment[]
  followUp           FollowUp?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  @@index([childId, observedAt])
  @@index([createdById])
  @@unique([createdById, idempotencyKey])
}

model MilestoneDefinition {
  id                String              @id @default(cuid())
  slug              String              @unique
  domain            String
  titleEn           String
  titleHi           String
  titleMr           String
  descriptionEn     String
  descriptionHi     String
  descriptionMr     String
  minAgeMonths      Int
  maxAgeMonths      Int
  reviewAfterMonths Int
  activitiesEn      Json
  activitiesHi      Json
  activitiesMr      Json
  active            Boolean             @default(true)
  assessments       MilestoneAssessment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([domain, minAgeMonths, maxAgeMonths])
}

model MilestoneAssessment {
  id                 String            @id @default(cuid())
  childId            String
  milestoneId        String
  observationId      String?
  assessedById       String
  assessedAt         DateTime
  status             String
  notes              String
  child              Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  milestone          MilestoneDefinition @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  observation        Observation?      @relation(fields: [observationId], references: [id], onDelete: SetNull)
  assessedBy         User              @relation(fields: [assessedById], references: [id], onDelete: Restrict)
  risks              RiskAssessment[]    @relation("RiskSourceMilestone")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  @@index([childId, assessedAt])
  @@index([milestoneId])
  @@index([assessedById])
  @@index([childId, milestoneId, assessedAt])
}

model DevelopmentAssessment {
  id                    String            @id @default(cuid())
  childId               String
  domain                String
  score                 Float
  assessmentMethod      String
  assessmentVersion     String
  assessedById          String
  assessedAt            DateTime
  sourceObservationId   String?
  notes                 String
  child                 Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  assessedBy            User              @relation(fields: [assessedById], references: [id], onDelete: Restrict)
  sourceObservation     Observation?      @relation(fields: [sourceObservationId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  @@index([childId, domain, assessedAt])
  @@index([assessmentMethod, assessmentVersion])
}

model FollowUp {
  id              String           @id @default(cuid())
  childId         String
  observationId   String?
  assignedToId    String?
  status          String           @default("OPEN")
  priority        String           @default("NORMAL")
  dueDate         DateTime?
  resolutionNotes String           @default("")
  child           Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  observation     Observation?     @relation(fields: [observationId], references: [id], onDelete: SetNull)
  assignedTo      User?            @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@index([childId, status, dueDate])
  @@index([assignedToId, status])
  @@unique([observationId])
}

model MLPrediction {
  id                   String                @id @default(cuid())
  childId              String?
  scopeCenterIds       Json
  modelName            String
  modelVersion         String
  predictionType       String
  predictionValue      Json
  confidenceValue      Float?
  inputDataCutoff      DateTime
  generatedAt          DateTime              @default(now())
  modelArtifactVersion String
  explanation          Json
  reviewStatus         String                @default("GENERATED")
  child                Child?                @relation(fields: [childId], references: [id], onDelete: SetNull)
  @@index([childId, predictionType, generatedAt])
  @@index([modelName, modelVersion])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  actorId     String
  key         String
  entityType  String
  entityId    String
  createdAt   DateTime @default(now())
  @@unique([actorId, key])
  @@index([entityType, entityId])
}

model RiskAssessment {
  id                    String               @id @default(cuid())
  childId               String
  level                 String
  title                 String
  explanation           String
  sourceObservationId   String?
  sourceMilestoneId     String?
  reviewRequired        Boolean              @default(true)
  child                 Child                @relation(fields: [childId], references: [id], onDelete: Cascade)
  sourceMilestone       MilestoneAssessment? @relation("RiskSourceMilestone", fields: [sourceMilestoneId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  @@index([childId])
}

model Recommendation {
  id                String    @id @default(cuid())
  childId           String
  createdById       String
  locale            String    @default("en")
  title             String
  description       String
  approvedForParent Boolean   @default(false)
  status            String    @default("PENDING")
  child             Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@index([childId, status])
}

model Message {
  id          String           @id @default(cuid())
  childId     String
  fromUserId  String
  toUserId    String
  direction   String
  locale      String           @default("en")
  subject     String
  body        String
  readAt      DateTime?
  child       Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  fromUser    User             @relation("MessageSender", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser      User             @relation("MessageRecipient", fields: [toUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([childId, createdAt])
}

model ReportRecord {
  id            String   @id @default(cuid())
  childId       String?
  centerId      String?
  generatedById String
  title         String
  periodLabel   String
  summary       String
  child         Child?   @relation(fields: [childId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([childId])
}

model ChatLog {
  id              String    @id @default(cuid())
  userId          String
  childId         String?
  locale          String    @default("en")
  question        String
  responseSummary String
  sourceRefs      Json
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  child           Child?    @relation(fields: [childId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String
  scopeCenterId String?
  metadata    Json?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  center      Center?  @relation(fields: [scopeCenterId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  @@index([scopeCenterId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model AuthSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt, expiresAt])
}

model RateLimitBucket {
  bucketKey       String   @id
  windowStartedAt DateTime
  count           Int
  updatedAt       DateTime @updatedAt
  @@index([windowStartedAt])
}
