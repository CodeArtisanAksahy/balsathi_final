{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/server.ts",
    "src/lib/domain.ts",
    "src/lib/demo-data.ts",
    "src/lib/demo-store.ts",
    "src/lib/authorization.ts",
    "src/lib/api.ts",
    "src/lib/backend.test.ts",
    "src/app/api/children/route.ts",
    "src/app/api/observations/route.ts"
  ]
}
