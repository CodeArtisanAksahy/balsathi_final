# Balsathi AI - Environment Configuration
# Copy this file to .env and adjust values. Never commit .env.

# ---- Data Mode ----
# "demo" (default): in-memory synthetic data, no database required.
# "postgres": use PostgreSQL via Prisma. Requires DATABASE_URL.
DATA_MODE=demo

# ---- App ----
APP_ORIGIN=http://localhost:3000
DEFAULT_LOCALE=en

# ---- Database (required only when DATA_MODE=postgres) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balsathi?schema=public"

# ---- Authentication ----
# Secret used to sign JWT session tokens. Use a long random value in production.
AUTH_SECRET=change-me-to-a-long-random-secret
SESSION_COOKIE=balsathi_session
SESSION_TTL_HOURS=12

# ---- LLM (optional) ----
# When unset, the AI assistant uses rule-based, record-grounded templates.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Speech-to-Text (optional) ----
# "demo" returns a mock transcript; set to a provider name when configured.
STT_PROVIDER=demo
STT_API_KEY=

# ---- Object Storage (optional) ----
# When S3_ENDPOINT and S3_BUCKET are set, uploads use S3; otherwise local filesystem.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Local storage (used when S3 is not configured) ----
LOCAL_STORAGE_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=

# ---- Rate Limiting ----
CHAT_RATE_LIMIT_PER_MIN=10
