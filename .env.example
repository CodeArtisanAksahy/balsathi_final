# Balsathi AI - Environment Configuration
# Copy this file to .env and adjust values. Never commit .env.

# ---- Data Mode ----
# "demo": in-memory synthetic data, no database required.
# "sqlite": local SQLite file via Prisma. Apply schema with `npm run db:migrate:deploy`.
DATA_MODE=sqlite

# ---- App ----
APP_ORIGIN=http://localhost:3000
DEFAULT_LOCALE=en

# ---- Database (SQLite, required only when DATA_MODE=sqlite) ----
# Relative to prisma/schema.prisma; creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Aggregate observation-volume forecast. Leave unset until an evaluated model
# artifact has been produced by ml/train_model.py. This is not child-level ML.
ML_MODEL_PATH=
PYTHON_BIN=python3
ML_EVALUATION_PATH=
ML_EXPORT_DIR=ml/private-data

# Optional private FastAPI service for the notebook's experimental classifiers.
# Keep this server-only URL on a private network; never use NEXT_PUBLIC_ here.
ML_SERVICE_URL=http://127.0.0.1:8001
# Only enables synthetic demo inference outside production. Production always disables it.
ML_ALLOW_EXPERIMENTAL=false
ML_MODEL_DIR=./models

# ---- Authentication ----
# Secret used to sign JWT session tokens. Replace before use; production requires at least 32 unique characters.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_COOKIE=balsathi_session
SESSION_TTL_HOURS=12

# ---- LLM (optional) ----
# When unset, the AI assistant uses rule-based, record-grounded templates.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Speech-to-Text (optional) ----
# "demo" returns a mock transcript; set to a provider name when configured.
STT_PROVIDER=demo
STT_API_KEY=

# ---- Object Storage (optional) ----
# When S3_ENDPOINT and S3_BUCKET are set, uploads use S3; otherwise local filesystem.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Local storage (used when S3 is not configured) ----
LOCAL_STORAGE_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=

# ---- Rate Limiting ----
CHAT_RATE_LIMIT_PER_MIN=10
